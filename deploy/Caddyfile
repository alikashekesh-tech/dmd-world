# Caddy in front of the DMD World server: automatic HTTPS, compression, one public address.
# The Node server listens on 127.0.0.1:8787 only. In server/.env set:
#   SERVE_STOREFRONT=true   TRUST_PROXY=true   COOKIE_SECURE=true   STOREFRONT_URL=https://shop.example.com
# Replace shop.example.com with the storefront's domain.

shop.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8787 {
		# The server's own health check; Caddy stops sending traffic while it fails.
		health_uri /healthz
		health_interval 30s
	}
	header -Server
	log {
		output file /var/log/caddy/dmd-world.log
	}
}
