# systemd unit for the DMD World server (storefront pages, /api and /admin).
# Install: copy to /etc/systemd/system/, adjust the paths and user, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now dmd-world
# Logs: journalctl -u dmd-world -f
[Unit]
Description=DMD World storefront and admin server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dmd
Group=dmd
WorkingDirectory=/srv/dmd-world/server
ExecStart=/usr/bin/node index.mjs
Restart=on-failure
RestartSec=3
# A graceful stop finishes open requests and saves buyer sessions (the server handles SIGTERM).
KillSignal=SIGTERM
TimeoutStopSec=15
Environment=NODE_ENV=production

# Hardening: the server only needs to write its data folder and its .env (the owner password hash).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/srv/dmd-world/server/data /srv/dmd-world/server/.env

[Install]
WantedBy=multi-user.target
