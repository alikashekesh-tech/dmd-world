{
  "name": "loadout-gaming-marketplace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:laravel": "vite --mode laravel --port 5175",
    "build": "vite build",
    "build:laravel": "vite build --mode laravel",
    "preview": "vite preview",
    "build:all": "vite build && npm --prefix server run build:admin",
    "lint": "eslint .",
    "test": "npm --prefix server test",
    "api:serve": "php backend/artisan serve --host=127.0.0.1 --port=8000",
    "test:api": "cd backend && php artisan test",
    "check": "npm run lint && npm run build:all && npm test && npm run test:api"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "vite": "^8.3.2"
  }
}
