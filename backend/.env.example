# DMD World API (Laravel). Copy to .env, then: php artisan key:generate && php artisan db:provision && php artisan migrate
# Never commit .env. Nothing here is ever sent to the browser: React only talks to /api/v1.

APP_NAME="DMD World"
# local | production
APP_ENV=local
APP_KEY=
# Must be false in production (true shows exception details to whoever triggers them).
APP_DEBUG=true
# Where this API itself runs (development: php artisan serve).
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ── The React apps ─────────────────────────────────────────────────────
# Storefront address (links in emails point here) and the owner's admin.
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin
# Hosts (host:port) whose browser requests get cookie sessions. Production: your domain, e.g. dmdworld.store
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
# Only needed if a React app is served from a different origin than /api/v1 (normally empty).
CORS_ALLOWED_ORIGINS=
# Reverse proxies allowed to set X-Forwarded-* (development: the Vite dev server; production: Caddy/nginx).
TRUSTED_PROXIES=127.0.0.1,::1
# Where "today" begins on the owner's dashboard (dates are stored in UTC).
STORE_TIMEZONE=Asia/Beirut

# ── MySQL: the single source of truth ──────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dmd_world
DB_USERNAME=dmd_world
# Leave empty: php artisan db:provision generates it and creates the account.
DB_PASSWORD=
# The test suite's own database (it is wiped on every run).
DB_TEST_DATABASE=dmd_world_testing

# ── Sessions (HttpOnly cookie, stored in MySQL) ───────────────────────
SESSION_DRIVER=database
SESSION_COOKIE=dmd_session
# Minutes of inactivity before a session ends ("remember me" keeps buyers signed in longer).
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# true in production (HTTPS only)
SESSION_SECURE_COOKIE=false

# Passwords are hashed with Argon2id.
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Email (password resets, order updates) ─────────────────────────────
# "log" writes emails to storage/logs/laravel.log instead of sending them. Production: smtp + the settings below.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@dmdworld.store"
MAIL_FROM_NAME="${APP_NAME}"

# ── One-time move from the old WooCommerce store (go-live only; see docs/deployment.md) ──
# php artisan dmd:import → dmd:verify-import → dmd:import-media. A READ-ONLY WooCommerce REST key is enough (only GET
# requests are sent). Remove these values once the old store is switched off.
IMPORT_WOO_URL=
IMPORT_WOO_KEY=
IMPORT_WOO_SECRET=
# Extra hosts dmd:import-media may copy images from (comma-separated), when they differ from IMPORT_WOO_URL's host.
IMPORT_MEDIA_HOSTS=
