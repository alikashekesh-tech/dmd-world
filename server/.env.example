# DMD World admin server. Copy to server/.env and fill in. Never commit server/.env.

# ── WooCommerce connection ──────────────────────────────────────────────
# The store's address, e.g. https://staging.dmdworld.store (staging first!)
WOO_URL=
# WooCommerce > Settings > Advanced > REST API > Add key (Read/Write for staging, Read for a first look at live)
WOO_KEY=
WOO_SECRET=
# emulator | staging | live — the admin shows a red LIVE banner when this is "live"
WOO_ENV=staging
# true = the server refuses every change (safe way to look at live data)
WOO_READ_ONLY=false
# true if your host strips the Authorization header (keys are then sent as query parameters over HTTPS)
WOO_QUERY_AUTH=false

# ── Owner login ─────────────────────────────────────────────────────────
# Set with: npm --prefix server run setup -- --password "your password"
OWNER_PASSWORD_HASH=
SESSION_SECRET=
SESSION_HOURS=12
# true when served over HTTPS
COOKIE_SECURE=false

# ── Buyer accounts on the storefront ────────────────────────────────────
# Shared secret between this server and the DMD Buyer Auth WordPress plugin (wordpress/dmd-buyer-auth).
# Generate with: npm --prefix server run setup -- --buyer-secret   then put the same value in wp-config.php:
#   define('DMD_AUTH_SECRET', '...');
# Empty = buyer sign-up/sign-in stay off (guest checkout and reviews display still work).
DMD_AUTH_SECRET=
# Where the storefront is served (password-reset links point here). Also set in wp-config.php:
#   define('DMD_STOREFRONT_URL', 'https://…');
STOREFRONT_URL=http://localhost:5173

# ── Optional ────────────────────────────────────────────────────────────
# Product image upload: a WordPress user + Application Password (Users > Profile > Application Passwords)
WP_USER=
WP_APP_PASSWORD=
# Where the admin UI runs during development
ADMIN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8787
# Network interface to listen on. 127.0.0.1 = this machine only (put nginx/Caddy in front for the public site).
HOST=127.0.0.1
# true only when a reverse proxy you control sits in front and sets X-Forwarded-For (used for rate limits).
TRUST_PROXY=false
STORE_NAME=DMD World
